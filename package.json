{
  "name": "react-express-mysql",
  "version": "1.0.0",
  "description": "Boiler plate using express has the backend and react has the frontend. Using mysql has the database",
  "scripts": {
    "test": "jest",
    "build": "webpack --config webpack.prod.js --mode production && node generatePackageJson.js",
    "dev": "nodemon --watch src --watch public --watch webpack.common.js --watch webpack.dev.js --watch .env --ignore dist --exec \"webpack --config webpack.dev.js --mode development && node dist/server.js -r newrelic\""
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/dist"
    ]
  },
