    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "terser-webpack-plugin": "^5.4.0",
    "webpack": "^5.106.2",
